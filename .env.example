# Set two different, long passwords before running docker compose.
# Use letters and numbers for the manager password (it is rendered into squid.conf).
SQUID_MANAGER_PASSWORD=replace-with-a-long-random-manager-password
UI_PASSWORD=replace-with-a-long-random-dashboard-password
UI_USERNAME=admin
# Set true when the dashboard is served exclusively over HTTPS.
UI_COOKIE_SECURE=false
UI_BIND=0.0.0.0
UI_PORT=8080
PROXY_BIND=0.0.0.0
PROXY_PORT=8000
